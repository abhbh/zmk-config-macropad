// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define ADJ 1
#define EDIT 2
#define FNM 3
#define NUM 4

&msc {
    acceleration-exponent = <1>;
    time-to-max-speed-ms = <500>;
};

/ {

    macros {
        select_line: select_line {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings
            = <&macro_tap &kp HOME>
            , <&macro_tap &kp LS(END)>
            ;
        };

        delete_line: delete_line {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings
            = <&macro_tap &kp HOME>
            , <&macro_tap &kp LS(END)>
            , <&macro_tap &kp BSPC>
            ;
        };

        search_web: search_web {
        compatible = "zmk,behavior-macro";
        #binding-cells = <0>;
        bindings
            = <&macro_tap   &kp K_APP>
            , <&macro_tap   &kp S>
            ;
        };
    };

    // Define a default keymap here.
    // See https://zmk.dev/docs/development/hardware-integration/new-shield#default-keymap.
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                &kp C_PP       &kp C_MUTE
                &mkp MB4       &mkp MCLK      &mkp MB5          &msc MOVE_UP
                &kp C_MUTE     &mkp LCLK      &mkp RCLK         &msc MOVE_DOWN
                &kp LC(LG(N3)) &kp LC(LG(N4)) &kp LC(LG(N6))    &kp LC(LG(N7))
                &mo ADJ        &mo EDIT       &mo FNM           &mo NUM
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN &inc_dec_kp PG_UP PG_DN>;
        };

        adjacent {
            display-name = "Adjacent";
            bindings = <
                &kp C_PP       &kp C_MUTE
                &kp KP_NUM     &none           &none       &none
                &to NUM        &to EDIT        &to FNM     &to NUM
                &kp C_AL_CALC  &none           &none       &none
                &none          &studio_unlock  &sys_reset  &bootloader
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN &inc_dec_kp PG_UP PG_DN>;
        };

        editor {
            display-name = "Editor";
            bindings = <
                &kp C_PP        &kp C_MUTE
                &kp LG(L)       &select_line   &delete_line    &kp LC(PG_UP)
                &kp LC(LS(ESC)) &search_web    &none           &kp LC(PG_DN)
                &none           &none          &none           &none
                &to BASE        &none          &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN &inc_dec_kp PG_UP PG_DN>;
        };

        fnmore {
            display-name = "FN13-24";
            bindings = <
                &kp C_PP        &kp C_MUTE
                &kp F13         &kp F14   &kp F15   &kp F16
                &kp F17         &kp F18   &kp F19   &kp F20
                &kp F21         &kp F22   &kp F23   &kp F24
                &to BASE        &none     &none     &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN &inc_dec_kp PG_UP PG_DN>;
        };

        numpad {
            display-name = "Numpad";
            bindings = <
                &kp C_PP        &kp C_MUTE
                &kp KP_N7       &kp KP_N8  &kp KP_N9  &kp KP_N0
                &kp KP_N4       &kp KP_N5  &kp KP_N6  &kp KP_PLUS
                &kp KP_N1       &kp KP_N2  &kp KP_N3  &kp KP_ENTER
                &to BASE        &none          &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
